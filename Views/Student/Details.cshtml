@model Student
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<dl>
    <dt>Id</dt>
    <dd>@Model.Id</dd>
    <dt>Email</dt>
    <dd>@Model.Email</dd>
    <dt>Course</dt>
    <dd>@Model.Course</dd>
    <dt>Semester</dt>
    <dd>@Model.Semester</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Back to list</a>
